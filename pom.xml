<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- ───────────────────────────────────────────
         Spring Boot Parent — управляет версиями
         всех зависимостей ниже автоматически.
         Менять версии вручную не нужно.
    ─────────────────────────────────────────────── -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <!-- ───────────────────────────────────────────
         Координаты проекта
    ─────────────────────────────────────────────── -->
    <groupId>com.example</groupId>
    <artifactId>bank-rest</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>bank-rest</name>
    <description>Bank Card Management REST API</description>

    <!-- ───────────────────────────────────────────
         Свойства: версии библиотек, которыми
         Spring Boot parent НЕ управляет сам.
    ─────────────────────────────────────────────── -->
    <properties>
        <java.version>17</java.version>

        <!-- JJWT — JWT токены -->
        <jjwt.version>0.12.6</jjwt.version>

        <!-- MapStruct — маппинг Entity ↔ DTO -->
        <mapstruct.version>1.6.3</mapstruct.version>

        <!-- Lombok — генерация boilerplate (@Getter, @Builder и т.д.) -->
        <!-- Версией управляет Spring Boot parent, но явно фиксируем для mapstruct-processor -->
        <lombok.version>1.18.34</lombok.version>

        <!-- SpringDoc OpenAPI — Swagger UI -->
        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>

        <!-- ═══════════════════════════════════════
             WEB — REST API
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <!-- Включает: Spring MVC, Jackson (JSON), встроенный Tomcat -->
        </dependency>

        <!-- ═══════════════════════════════════════
             SECURITY — аутентификация и авторизация
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
            <!-- Включает: Spring Security, фильтры, BCryptPasswordEncoder -->
        </dependency>

        <!-- ═══════════════════════════════════════
             JWT — JSON Web Tokens (io.jsonwebtoken)
             Три артефакта нужны всегда вместе:
             api    — интерфейсы и аннотации
             impl   — реализация (runtime)
             jackson — сериализация claims через Jackson
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
            <!-- runtime: нужен при запуске, но не при компиляции -->
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ═══════════════════════════════════════
             DATA JPA — работа с БД через ORM
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
            <!-- Включает: Hibernate, Spring Data, управление транзакциями -->
        </dependency>

        <!-- ═══════════════════════════════════════
             POSTGRESQL — JDBC-драйвер
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
            <!-- runtime: нужен только при запуске, не при компиляции -->
        </dependency>

        <!-- ═══════════════════════════════════════
             LIQUIBASE — миграции схемы БД
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <!-- Версией управляет Spring Boot parent -->
        </dependency>

        <!-- ═══════════════════════════════════════
             VALIDATION — аннотации @NotBlank, @Email,
             @DecimalMin и т.д. на DTO
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <!-- Включает: Hibernate Validator (реализация Bean Validation) -->
        </dependency>

        <!-- ═══════════════════════════════════════
             LOMBOK — убирает boilerplate:
             @Getter, @Setter, @Builder,
             @RequiredArgsConstructor и т.д.
             provided: нужен только во время компиляции
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ═══════════════════════════════════════
             MAPSTRUCT — генерирует маппинг
             Entity ↔ DTO во время компиляции.
             Быстрее ручного маппинга и ModelMapper.
             provided: нужен только во время компиляции
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${mapstruct.version}</version>
        </dependency>
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct-processor</artifactId>
            <version>${mapstruct.version}</version>
            <scope>provided</scope>
        </dependency>

        <!-- ═══════════════════════════════════════
             SPRINGDOC OPENAPI — Swagger UI
             После запуска доступен по адресу:
             http://localhost:8080/swagger-ui/index.html
        ═══════════════════════════════════════════ -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ═══════════════════════════════════════
             ТЕСТЫ
        ═══════════════════════════════════════════ -->

        <!-- spring-boot-starter-test включает:
             JUnit 5, Mockito, AssertJ, MockMvc,
             Spring Test, Hamcrest -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Security тест: @WithMockUser,
             SecurityMockMvcRequestPostProcessors и т.д. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 — in-memory БД только для тестов.
             Не нужно поднимать PostgreSQL для unit/интеграционных тестов. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!-- ═══════════════════════════════════
                 Spring Boot Maven Plugin:
                 - mvn spring-boot:run    — запуск
                 - mvn package            — fat JAR
                   (все зависимости внутри одного jar)
            ═══════════════════════════════════════ -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok не нужен в итоговом JAR -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- ═══════════════════════════════════
                 Maven Compiler Plugin:
                 Нужен для корректной работы
                 annotation processors (Lombok + MapStruct).
                 Порядок в annotationProcessorPaths важен:
                 Lombok должен идти ПЕРЕД MapStruct,
                 иначе MapStruct не увидит Lombok-геттеры.
            ═══════════════════════════════════════ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <!-- 1. Lombok ПЕРВЫМ — генерирует геттеры/сеттеры -->
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <!-- 2. MapStruct ВТОРЫМ — использует геттеры от Lombok -->
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                    <compilerArgs>
                        <!-- Передаём MapStruct настройку:
                             использовать Spring для внедрения маппера через @Autowired -->
                        <arg>-Amapstruct.defaultComponentModel=spring</arg>
                    </compilerArgs>
                </configuration>
            </plugin>

        </plugins>
    </build>

</project>